sig.age.genes
library(org.Mm.eg.db)
# Get Entrez IDs
gene_ids <- bitr(sig.age.genes, fromType="SYMBOL", toType="ENTREZID", OrgDb=org.Mm.eg.db)
gene_ids
ego <- enrichGO(gene          = gene_ids$ENTREZID,
OrgDb         = org.Mm.eg.db,
keyType       = "ENTREZID",
ont           = "BP",   # or "MF", "CC"
pAdjustMethod = "BH",
pvalueCutoff  = 0.05,
qvalueCutoff  = 0.05)
as.data.frame(ego)
# top 10 enriched pathways in samples compared to controls
barplot(ego, showCategory = 10, color = "p.adjust") +
theme_classic() +
scale_fill_gradient(low = "lightblue", high = "dodgerblue")
# top 10 enriched pathways in samples compared to controls
barplot(ego, showCategory = 10, color = "p.adjust")
# top 10 enriched pathways in samples compared to controls
barplot(ego, showCategory = 10, title = "Top 10 Enriched GO Pathways")
# top 10 enriched pathways in samples compared to controls
barplot(ego, showCategory = 10,
orderBy = "p.adjust",
title = "Top 10 Enriched GO Pathways")
as.data.frame(ego)
dotplot(ego, showCategory = 10, orderBy = "p.adjust", title = "Top 10 Enriched GO Pathways")
# top 10 enriched pathways in samples compared to controls
barplot(ego, showCategory=10)
# Get Entrez IDs
gene.ids <- bitr(sig.age.genes, fromType="SYMBOL", toType="ENTREZID", OrgDb=org.Mm.eg.db)
# KEGG pathway enrichment
ekegg <- enrichKEGG(gene         = gene.ids$ENTREZID,
organism     = 'mmu',   # 'hsa' for human
pvalueCutoff = 0.05)
barplot(ekegg, showCategory=10)
